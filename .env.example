# ---------- Public (safe for the browser) ----------
NEXT_PUBLIC_APP_NAME="NutriTrack AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Supabase "anon" / publishable key. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
# Used only for account deletion and storage cleanup. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# AI provider: "anthropic" | "openai" | "none" (default when unset)
AI_PROVIDER="none"
AI_API_KEY=""
# Must be a vision-capable model if you want photo analysis.
AI_MODEL=""
# Optional: base URL for OpenAI-compatible endpoints (e.g. a self-hosted gateway).
AI_BASE_URL=""
# Per-user daily cap on AI analysis calls (cost control).
AI_DAILY_LIMIT_PER_USER="30"
# Request timeout for AI calls, in milliseconds.
AI_TIMEOUT_MS="25000"

# Food image uploads
FOOD_IMAGE_BUCKET="food-images"
MAX_UPLOAD_MB="5"
